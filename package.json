{
  "name": "eclipse-site",
  "version": "1.0.0",
  "private": true,
  "description": "Site ÉCLIPSE — CI/CD",
  "scripts": {
    "ci": "npm run lint:html && npm run lint:css && npm run lint:js && npm run check:data",
    "lint:html": "html-validate \"*.html\"",
    "lint:css": "stylelint \"css/**/*.css\"",
    "lint:js": "eslint \"js/**/*.js\"",
    "check:data": "node scripts/validate-data.mjs",
    "push": "node scripts/push.mjs",
    "release": "node scripts/release.mjs",
    "release:merge": "node scripts/release.mjs --merge"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "html-validate": "^11.21.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0"
  }
}
